# Node listens here. Hosts like Railway set PORT for you.
PORT=8787

# Signs run tokens and wallet sessions. Change this in production.
RUN_SECRET=change-me

# Comma-separated frontend origins allowed to call this API.
# Localhost and private LAN are always allowed.
# CORS_ORIGINS=https://versus-words.vercel.app
CORS_ORIGINS=

# Where matches.json is written. Defaults to <repo>/data
# DATA_DIR=/var/data
DATA_DIR=

# ENABLE word list. Defaults to <repo>/data/enable.txt
# DICT_PATH=/app/data/enable.txt
DICT_PATH=

# --- NIM versus (Pay send + watched address) ---
# Required when FAKE_CHAIN=0 and the room asset is NIM.
ESCROW_ADDRESS=
NIMIQ_RPC=https://rpc.nimiqwatch.com

# 1 = credit stakes without watching a chain (local / demo).
# 0 = real deposits (NIM RPC and/or Polygon escrow).
FAKE_CHAIN=1

# --- USDT versus (Polygon). Mainnet: chain 137. Amoy: 80002. ---
USDT_TOKEN=
USDT_ESCROW=
POLYGON_CHAIN_ID=137
POLYGON_RPC=https://polygon-bor-rpc.publicnode.com
# 32-byte hex. Address must match VersusEscrow constructor oracle.
POLYGON_ORACLE_KEY=
