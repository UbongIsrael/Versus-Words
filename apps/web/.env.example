# Public API origin. No trailing slash.
# Local `npm run dev`: leave empty — Vite proxies /api, /health, /dictionary.txt.
# Vercel (or any static host): set this at BUILD time. Vite inlines VITE_* vars.
#
# VITE_API_URL=https://your-api.up.railway.app
VITE_API_URL=

# Only used by `vite` locally, to proxy API requests.
VITE_DEV_API_PROXY=http://localhost:8787
